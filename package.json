{
  "name": "microsendr",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "ws@>=8 <8.21.0": "8.21.0",
      "uuid@>=8 <10": "11.1.1",
      "decode-uri-component@<0.5.0": "0.5.0"
    }
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "sandbox:init": "tsx scripts/sandbox-init.ts",
    "sandbox:create": "tsx scripts/sandbox-create.ts",
    "dev:api": "tsx watch services/api/src/index.ts",
    "dev:worker": "tsx watch services/worker/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev": "concurrently -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "start": "tsx services/api/src/index.ts",
    "worker": "tsx services/worker/src/index.ts",
    "webhook:receiver": "tsx scripts/webhook-receiver.ts",
    "smoke:phase1": "tsx scripts/phase1-smoke.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm generate && pnpm typecheck && pnpm sdk:build && vite build --config apps/web/vite.config.ts",
    "generate": "tsx scripts/generate-contract.ts",
    "contract:check": "tsx scripts/generate-contract.ts --check",
    "sdk:build": "tsup --config sdks/typescript/tsup.config.ts",
    "test": "tsx --test tests/core.test.ts tests/signer.test.ts tests/didit.test.ts tests/qie.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts tests/engine.test.ts tests/product.test.ts tests/rails.test.ts tests/stellar.test.ts tests/controls.test.ts tests/network.test.ts tests/routing.test.ts tests/queue.test.ts tests/auth.test.ts tests/personal.test.ts tests/personal-paystack.test.ts tests/business-email.test.ts tests/qie-settlement.test.ts tests/consumer.test.ts",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm test:integration",
    "paystack:check": "tsx scripts/paystack-check.ts",
    "smoke:phase3": "tsx scripts/phase3-smoke.ts",
    "test:browser:rail": "playwright test --config playwright.rail.config.ts",
    "stellar:init": "tsx scripts/stellar-init.ts",
    "smoke:phase4": "tsx scripts/phase4-smoke.ts",
    "test:browser:stellar": "playwright test --config playwright.stellar.config.ts",
    "operator:enroll": "tsx scripts/operator-enroll.ts",
    "backup:drill": "tsx scripts/backup-drill.ts",
    "test:controls": "tsx --test tests/controls.test.ts",
    "smoke:phase5": "tsx scripts/phase5-smoke.ts",
    "test:browser:controls": "playwright test --config playwright.controls.config.ts",
    "test:network": "tsx --test tests/network.test.ts",
    "smoke:phase6": "tsx scripts/phase6-smoke.ts",
    "preview:check": "tsx scripts/mobile-preview-check.ts",
    "test:routing": "tsx --test tests/routing.test.ts",
    "smoke:phase7": "tsx scripts/phase7-smoke.ts",
    "test:browser:network": "playwright test --config playwright.network.config.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:browser:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@didit-protocol/sdk-web": "^0.4.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@privy-io/react-auth": "3.46.0",
    "@stellar/stellar-sdk": "17.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "nodemailer": "10.1.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "viem": "2.56.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "fast-check": "^4.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
