DATABASE_URL=postgres://kora:kora_local_only@127.0.0.1:55432/kora
KORA_MODE=sandbox
HOST=127.0.0.1
PORT=4310
# Generate local keys with pnpm sandbox:init; do not copy example values as keys.
KORA_WEBHOOK_ENCRYPTION_KEY=
KORA_PROVIDER_CALLBACK_SECRET=
KORA_WEBHOOK_ALLOWED_ORIGINS=http://127.0.0.1:4311
KORA_CONSOLE_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176,http://localhost:5176

# Email verification, password recovery and Business email sign-in. Leave blank to
# disable them; without SMTP no user can verify an email, recover a password or start
# identity verification. KORA_AUTH_SECRET must be at least 32 random bytes
# (openssl rand -hex 32); shorter values are rejected at startup.
KORA_AUTH_SECRET=
# Sender for code emails, on a domain verified with your provider,
# e.g. Microsendr <codes@yourdomain>. SMTP_FROM is accepted as a fallback.
EMAIL_FROM=
# Preferred: Resend's HTTPS API (no outbound SMTP port needed). Server-side only.
RESEND_API_KEY=
# Alternative: any SMTP relay.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Phase 3: Paystack test secret key only. Leave blank for the simulator workspace.
# Live keys are rejected; never put provider keys in frontend variables.
PAYSTACK_SECRET_KEY=

# Phase 4: isolated Stellar Testnet configuration, generated by pnpm stellar:init.
STELLAR_TESTNET_ISSUER=
STELLAR_TESTNET_TREASURY_SECRET=

# Phase 5: optional HTTPS custody bridge; remote mode never falls back to local secrets.
STELLAR_SIGNER_MODE=local
STELLAR_TESTNET_TREASURY_PUBLIC_KEY=
STELLAR_SIGNER_URL=
STELLAR_SIGNER_TOKEN=
# Local encrypted restore drill uses matching tools inside this PostgreSQL container.
KORA_POSTGRES_CONTAINER=kora-postgres

# Optional Vite mobile preview: exact Cloudflare Tunnel hostname, no scheme
KORA_DEV_PORT=5176
KORA_PREVIEW_HOST=
# Append the matching https:// hostname to KORA_CONSOLE_ORIGINS above.

# Privy. PRIVY_APP_ID and a server-only PRIVY_APP_SECRET provision each Personal
# account's managed wallet address; without the secret, wallets stay unprovisioned.
# Rotate any secret that has ever been shared outside a secret store.
# Enable Email login and identity tokens in Privy, and allow each exact site origin.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_CLIENT_ID=
# Optional pinned P-256 public verification key from Privy dashboard.
# When empty, the API verifies tokens against Privy's app-scoped HTTPS JWKS.
PRIVY_VERIFICATION_KEY=
# Privy policy attached to every account wallet (created by scripts/privy-policy.ts --apply).
# It caps what Privy will sign even if this server were compromised.
PRIVY_POLICY_ID=

# Server-side only. The KYC workflow ID is configured in code.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Production and proxy settings.
# NODE_ENV=production requires DATABASE_URL and KORA_MODE, fails closed on an empty
# KORA_CONSOLE_ORIGINS, forces Secure cookies and disables sandbox fixtures.
NODE_ENV=
# Self-approval, simulated NGN, P2P fixture and Personal Paystack test routes.
# Default: on outside production, off in production. Set true/false to override.
KORA_SANDBOX_FIXTURES=
# Proxies whose X-Forwarded-For is trusted (proxy-addr syntax). Default: loopback,uniquelocal.
KORA_TRUSTED_PROXIES=
# Same value as the Netlify KORA_PROXY_SIGNING_SECRET environment variable. Netlify signs
# proxied API requests (X-Nf-Sign) so the API can trust X-Nf-Client-Connection-Ip.
KORA_PROXY_SIGNING_SECRET=
# Browser routes (/personal/api, except webhooks and /personal/api/health) need a valid
# proxy signature. Default: on in production when KORA_PROXY_SIGNING_SECRET is set.
KORA_REQUIRE_PROXY_SIGNATURE=
# The retired business platform (/v1, /console, /business, /openapi.json, /reference).
# Default: off in production, on elsewhere for regression tests. Set true/false to override.
KORA_LEGACY_PLATFORM=
# Passkey relying-party ID. Default: the hostname of the request's allowed Origin.
KORA_WEBAUTHN_RP_ID=
# Optional QIE Mainnet RPC override (HTTPS only). Default: https://rpc1mainnet.qie.digital/
QIE_RPC_URL=
# Database pool size per process (default 12).
DATABASE_POOL_MAX=
# Worker heartbeat file read by the container healthcheck (default /tmp/worker-heartbeat).
KORA_WORKER_HEARTBEAT=
# Optional worker HTTP probe port (GET /health). The worker also exits after five minutes
# without progress so the platform restarts it.
KORA_WORKER_HEALTH_PORT=
# scripts/webhook-receiver.ts verification secret for local webhook testing.
KORA_RECEIVER_SECRET=

# Sending from Privy-managed account wallets (custodial). Off unless "true".
# Each send needs the payment PIN, a passkey or the password, a verified email and,
# unless set to "false", approved Didit identity verification. Limits are whole units.
KORA_MANAGED_TRANSFERS=
KORA_MANAGED_TRANSFERS_REQUIRE_KYC=
KORA_MANAGED_TRANSFER_MAX_QIE=1000
KORA_MANAGED_TRANSFER_DAILY_QIE=5000
KORA_MANAGED_TRANSFER_MAX_QUSDC=1000
KORA_MANAGED_TRANSFER_DAILY_QUSDC=5000
# Smaller limits for accounts without approved identity verification (only reachable
# when KORA_MANAGED_TRANSFERS_REQUIRE_KYC=false).
KORA_UNVERIFIED_TRANSFER_MAX_QIE=50
KORA_UNVERIFIED_TRANSFER_DAILY_QIE=100
KORA_UNVERIFIED_TRANSFER_MAX_QUSDC=50
KORA_UNVERIFIED_TRANSFER_DAILY_QUSDC=100
# General per-client request limit per minute (default 300). Raise only for test servers.
KORA_RATE_LIMIT_MAX=
# Where that limit is counted: memory (default, one API instance) or postgres (shared by
# every API instance; set this before running more than one).
KORA_RATE_LIMIT_STORE=
# Temporary override: allow account-wallet sends in production without PRIVY_POLICY_ID.
KORA_ALLOW_UNPOLICED_TRANSFERS=

# Fonbnk (buy stablecoins with naira; buy and sell quotes). Server-side only.
# Client ID and "API signature secret" from Fonbnk's dashboard, Navigation > Integration.
# The merchant account needs Fonbnk's "create users" permission for orders.
FONBNK_CLIENT_ID=
FONBNK_SIGNATURE_SECRET=
# Webhook secret from Fonbnk's dashboard; webhooks post to
# ${KORA_PUBLIC_API_URL}/personal/api/webhooks/fonbnk.
FONBNK_WEBHOOK_SECRET=
# Default sandbox; production is https://api.fonbnk.com
FONBNK_BASE_URL=
# NETWORK_ASSET codes offered to buyers. Only EVM US-dollar stablecoins are accepted;
# others are ignored. Coins are delivered to the buyer's linked self-custody wallet.
FONBNK_ASSETS=POLYGON_USDC,BASE_USDC,CELO_USDT
# Public origin used for provider webhook URLs (Fonbnk, Didit setup script), e.g.
# https://microsendr.xyz (proxied to the API) or the API's own domain.
KORA_PUBLIC_API_URL=
