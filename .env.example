DATABASE_URL=postgres://kora:kora_local_only@127.0.0.1:55432/kora
KORA_MODE=sandbox
HOST=127.0.0.1
PORT=4310
# Generate local keys with pnpm sandbox:init; do not copy example values as keys.
KORA_WEBHOOK_ENCRYPTION_KEY=
KORA_PROVIDER_CALLBACK_SECRET=
KORA_WEBHOOK_ALLOWED_ORIGINS=http://127.0.0.1:4311
KORA_CONSOLE_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176,http://localhost:5176

# Email verification, password recovery and Business email sign-in. Leave blank to
# disable them; without SMTP no user can verify an email, recover a password or start
# identity verification. KORA_AUTH_SECRET must be at least 32 random bytes
# (openssl rand -hex 32); shorter values are rejected at startup.
KORA_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Phase 3: Paystack test secret key only. Leave blank for the simulator workspace.
# Live keys are rejected; never put provider keys in frontend variables.
PAYSTACK_SECRET_KEY=

# Phase 4: isolated Stellar Testnet configuration, generated by pnpm stellar:init.
STELLAR_TESTNET_ISSUER=
STELLAR_TESTNET_TREASURY_SECRET=

# Phase 5: optional HTTPS custody bridge; remote mode never falls back to local secrets.
STELLAR_SIGNER_MODE=local
STELLAR_TESTNET_TREASURY_PUBLIC_KEY=
STELLAR_SIGNER_URL=
STELLAR_SIGNER_TOKEN=
# Local encrypted restore drill uses matching tools inside this PostgreSQL container.
KORA_POSTGRES_CONTAINER=kora-postgres

# Optional Vite mobile preview: exact Cloudflare Tunnel hostname, no scheme
KORA_DEV_PORT=5176
KORA_PREVIEW_HOST=
# Append the matching https:// hostname to KORA_CONSOLE_ORIGINS above.

# Privy. PRIVY_APP_ID and a server-only PRIVY_APP_SECRET provision each Personal
# account's managed wallet address; without the secret, wallets stay unprovisioned.
# Rotate any secret that has ever been shared outside a secret store.
# Enable Email login and identity tokens in Privy, and allow each exact site origin.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_CLIENT_ID=
# Optional pinned P-256 public verification key from Privy dashboard.
# When empty, the API verifies tokens against Privy's app-scoped HTTPS JWKS.
PRIVY_VERIFICATION_KEY=

# Server-side only. The KYC workflow ID is configured in code.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Production and proxy settings.
# NODE_ENV=production requires DATABASE_URL and KORA_MODE, fails closed on an empty
# KORA_CONSOLE_ORIGINS, forces Secure cookies and disables sandbox fixtures.
NODE_ENV=
# Self-approval, simulated NGN, P2P fixture and Personal Paystack test routes.
# Default: on outside production, off in production. Set true/false to override.
KORA_SANDBOX_FIXTURES=
# Proxies whose X-Forwarded-For is trusted (proxy-addr syntax). Default: loopback,uniquelocal.
KORA_TRUSTED_PROXIES=
# Same value as the Netlify KORA_PROXY_SIGNING_SECRET environment variable. Netlify signs
# proxied API requests (X-Nf-Sign) so the API can trust X-Nf-Client-Connection-Ip.
KORA_PROXY_SIGNING_SECRET=
# Optional QIE Mainnet RPC override (HTTPS only). Default: https://rpc1mainnet.qie.digital/
QIE_RPC_URL=
# Database pool size per process (default 12).
DATABASE_POOL_MAX=
# Worker heartbeat file read by the container healthcheck (default /tmp/worker-heartbeat).
KORA_WORKER_HEARTBEAT=
# scripts/webhook-receiver.ts verification secret for local webhook testing.
KORA_RECEIVER_SECRET=
