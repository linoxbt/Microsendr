DATABASE_URL=postgres://kora:kora_local_only@127.0.0.1:55432/kora
KORA_MODE=sandbox
HOST=127.0.0.1
PORT=4310
# Generate local keys with pnpm sandbox:init; do not copy example values as keys.
KORA_WEBHOOK_ENCRYPTION_KEY=
KORA_PROVIDER_CALLBACK_SECRET=
KORA_WEBHOOK_ALLOWED_ORIGINS=http://127.0.0.1:4311
KORA_CONSOLE_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176,http://localhost:5176

# v2 Personal and Business email codes. Leave blank to disable both sign-ins.
# Generate KORA_AUTH_SECRET as an independent high-entropy secret.
KORA_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Phase 3: Paystack test secret key only. Leave blank for the simulator workspace.
# Live keys are rejected; never put provider keys in frontend variables.
PAYSTACK_SECRET_KEY=

# Phase 4: isolated Stellar Testnet configuration, generated by pnpm stellar:init.
STELLAR_TESTNET_ISSUER=
STELLAR_TESTNET_TREASURY_SECRET=
# Optional private retention of Orion credential; deliberately unused by Kora.
ORION_PAYSTACK_SECRET_KEY=

# Phase 5: optional HTTPS custody bridge; remote mode never falls back to local secrets.
STELLAR_SIGNER_MODE=local
STELLAR_TESTNET_TREASURY_PUBLIC_KEY=
STELLAR_SIGNER_URL=
STELLAR_SIGNER_TOKEN=
# Local encrypted restore drill uses matching tools inside this PostgreSQL container.
KORA_POSTGRES_CONTAINER=kora-postgres

# Optional Vite mobile preview: exact Cloudflare Tunnel hostname, no scheme
KORA_DEV_PORT=5176
KORA_PREVIEW_HOST=
# Append the matching https:// hostname to KORA_CONSOLE_ORIGINS above.

# Microsendr Personal and Business login. No Privy app secret is required.
# Enable Email login and identity tokens in Privy, and allow each exact site origin.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
# Optional pinned P-256 public verification key from Privy dashboard.
# When empty, the API verifies tokens against Privy's app-scoped HTTPS JWKS.
PRIVY_VERIFICATION_KEY=

# Server-side only. The KYC workflow ID is configured in code.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
